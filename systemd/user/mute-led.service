[Unit]
Description=Keep the F1 mute light in sync with the default audio output
After=pipewire-pulse.service
Wants=pipewire-pulse.service
PartOf=graphical-session.target

[Service]
ExecStart=%h/.local/bin/rice-sync-mute-led
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
